local function createLabel(text, pos)
    local lbl = Instance.new("TextLabel", scroll)
    lbl.Size = UDim2.new(0.9, 0, 0, 20)
    lbl.Position = UDim2.new(0.05, 0, 0, pos)
    lbl.Text = text; lbl.TextColor3 = Color3.new(1, 1, 1); lbl.BackgroundTransparency = 1
    return lbl
end

local function createButton(text, pos)
    local btn = Instance.new("TextButton", scroll)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, pos)
    btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    btn.Text = text; btn.TextColor3 = Color3.new(1, 1, 1)
    return btn
end

local function createBox(text, pos)
    local box = Instance.new("TextBox", scroll)
    box.Size = UDim2.new(0.9, 0, 0, 30)
    box.Position = UDim2.new(0.05, 0, 0, pos)
    box.Text = text
    return box
end

createLabel("المشي:", 10)
local walkBtn = createButton("المشي: مطفأ", 35)
local wsBox = createBox("16", 80)

createLabel("الطيران:", 120)
local flyBtn = createButton("الطيران: مطفأ", 145)
local flyBox = createBox("100", 190)

local noclipBtn = createButton("Noclip: مطفأ", 230)
local espBtn = createButton("ESP: مطفأ", 275)

local walking, flying, noclip, esp = false, false, false, false
local onColor, offColor = Color3.fromRGB(0, 150, 0), Color3.fromRGB(150, 0, 0)

walkBtn.MouseButton1Click:Connect(function() walking = not walking; walkBtn.BackgroundColor3 = walking and onColor or offColor; walkBtn.Text = walking and "المشي: يعمل" or "المشي: مطفأ" end)
flyBtn.MouseButton1Click:Connect(function() flying = not flying; flyBtn.BackgroundColor3 = flying and onColor or offColor; flyBtn.Text = flying and "الطيران: يعمل" or "الطيران: مطفأ" end)
noclipBtn.MouseButton1Click:Connect(function() noclip = not noclip; noclipBtn.BackgroundColor3 = noclip and onColor or offColor; noclipBtn.Text = noclip and "Noclip: يعمل" or "Noclip: مطفأ" end)
espBtn.MouseButton1Click:Connect(function() 
    esp = not esp; espBtn.BackgroundColor3 = esp and onColor or offColor; espBtn.Text = esp and "ESP: يعمل" or "ESP: مطفأ"
    for _,v in pairs(game.Players:GetPlayers()) do
        if v.Character and v.Character:FindFirstChild("Highlight") then v.Character.Highlight:Destroy() end
        if esp and v ~= p and v.Character then local h = Instance.new("Highlight", v.Character) h.FillColor = Color3.new(1, 0, 0) end
    end
end)

run.RenderStepped:Connect(function()
    local char = p.Character; local hum = char and char:FindFirstChild("Humanoid"); local root = char and char:FindFirstChild("HumanoidRootPart")
    if hum then hum.WalkSpeed = walking and (tonumber(wsBox.Text) or 16) or 16 end
    if noclip and char then for _,v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end end
    
    if flying and root and hum then
        hum.PlatformStand = true; local bv = root:FindFirstChild("FlyVelocity") or Instance.new("BodyVelocity", root) local bg = root:FindFirstChild("FlyGyro") or Instance.new("BodyGyro", root)
        bv.Name = "FlyVelocity"; bg.Name = "FlyGyro"; bv.MaxForce = Vector3.new(1/0,1/0,1/0); bg.MaxTorque = Vector3.new(1/0,1/0,1/0); bg.P = 50000
        local move = hum.MoveDirection; local camCF = cam.CFrame
        if move.Magnitude > 0 then local rel = camCF:VectorToObjectSpace(move) bv.Velocity = ((camCF.LookVector * -rel.Z) + (camCF.RightVector * rel.X)).Unit * (tonumber(flyBox.Text) or 100) else bv.Velocity = Vector3.new(0,0,0) end
        bg.CFrame = camCF; root.RotVelocity = Vector3.new(0,0,0)
    elseif root and root:FindFirstChild("FlyVelocity") then
        root.FlyVelocity:Destroy(); root.FlyGyro:Destroy(); hum.PlatformStand = false
    end
end)

task.spawn(function() while true do local h = tick()%10/10 title.TextColor3 = Color3.fromHSV(h,1,1) task.wait() end end)
