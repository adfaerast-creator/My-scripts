hbBtn.Text = "الهيكل المخفي (تفعيل)"

local walking, flying, hitbox = false, false, false

walkBtn.MouseButton1Click:Connect(function() walking = not walking walkBtn.BackgroundColor3 = walking and onColor or offColor walkBtn.Text = walking and "المشي: يعمل" or "المشي: مطفأ" end)
flyBtn.MouseButton1Click:Connect(function() flying = not flying flyBtn.BackgroundColor3 = flying and onColor or offColor flyBtn.Text = flying and "الطيران: يعمل" or "الطيران: مطفأ" if not flying then pcall(function() p.Character.HumanoidRootPart:FindFirstChild("FlyVelocity"):Destroy() p.Character.HumanoidRootPart:FindFirstChild("FlyGyro"):Destroy() p.Character.Humanoid.PlatformStand = false end) end end)
hbBtn.MouseButton1Click:Connect(function() if not hitbox then hitbox = true hbBtn.BackgroundColor3 = onColor hbBtn.Text = "الهيكل المخفي: مفعل" end end)

run.RenderStepped:Connect(function()
    local char = p.Character local hum = char and char:FindFirstChild("Humanoid") local root = char and char:FindFirstChild("HumanoidRootPart")
    if hum then hum.WalkSpeed = walking and (tonumber(wsBox.Text) or 16) or 16 end
    if flying and root and hum then
        hum.PlatformStand = true local bv = root:FindFirstChild("FlyVelocity") or Instance.new("BodyVelocity", root) local bg = root:FindFirstChild("FlyGyro") or Instance.new("BodyGyro", root)
        bv.Name = "FlyVelocity" bg.Name = "FlyGyro" bv.MaxForce = Vector3.new(1/0,1/0,1/0) bg.MaxTorque = Vector3.new(1/0,1/0,1/0) bg.P = 50000
        local move = hum.MoveDirection local camCF = cam.CFrame
        if move.Magnitude > 0 then local rel = camCF:VectorToObjectSpace(move) bv.Velocity = ((camCF.LookVector * -rel.Z) + (camCF.RightVector * rel.X)).Unit * (tonumber(flyBox.Text) or 100) else bv.Velocity = Vector3.new(0,0,0) end
        bg.CFrame = camCF root.RotVelocity = Vector3.new(0,0,0)
    end
    if hitbox then for _,v in next, game:GetService('Players'):GetPlayers() do if v ~= p and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then pcall(function()
        v.Character.HumanoidRootPart.Size = Vector3.new(50,50,50) v.Character.HumanoidRootPart.Transparency = 0.9 v.Character.HumanoidRootPart.BrickColor = BrickColor.new("Really red") v.Character.HumanoidRootPart.Material = "Neon" v.Character.HumanoidRootPart.CanCollide = false
    end) end end end
end)

