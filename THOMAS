local p = game:GetService("Players").LocalPlayer
local run = game:GetService("RunService")
local cam = workspace.CurrentCamera
local screenGui = Instance.new("ScreenGui", p:WaitForChild("PlayerGui"))
screenGui.Name = "ThomasMenu"
screenGui.ResetOnSpawn = false

local toggleBtn = Instance.new("ImageButton", screenGui)
toggleBtn.Size = UDim2.new(0, 50, 0, 50)
toggleBtn.Position = UDim2.new(0.05, 0, 0.5, -25)
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 105, 148)
toggleBtn.Active = true
toggleBtn.Draggable = true
local corner = Instance.new("UICorner", toggleBtn)
corner.CornerRadius = UDim.new(1, 0)

local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 200, 0, 380)
frame.Position = UDim2.new(0.5, -100, 0.2, 0)
